{
    "name": "deliciousbrains/wp-migrate-db-anonymization",
    "description": "An extension to WP Migrate DB Pro that anonymizes user data",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4",
        "fakerphp/faker": "^1.24"
    },
    "license": "GPLv3",
    "authors": [
        {
            "name": "Iain",
            "email": "iain@polevaultweb.com"
        }
    ],
    "autoload": {
      "psr-4": {
        "WPMDB\\Anonymization\\": "includes"
      },
      "files": [
        "includes/Compatibility.php"
      ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "WPMDB\\Anonymization\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "build": "bash bin/build.sh"
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "platform-check": false
    }
}
